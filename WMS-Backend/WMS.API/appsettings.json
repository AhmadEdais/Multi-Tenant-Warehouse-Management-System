{
  "Demo": { "Enabled": false, "MaxActiveTenants": 30 },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Frontend": {
        "AllowedOrigins": ["http://localhost:4200"]
    },
    "JwtSettings": {
        "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
        "Issuer": "WmsAPI",
        "Audience": "WmsClient",
        "ExpiryMinutes": 15
    },
    "AuthSessionPolicy": {
        "NonPersistentIdleMinutes": 120,
        "NonPersistentAbsoluteMinutes": 480,
        "PersistentIdleHours": 24,
        "PersistentAbsoluteDays": 14
    }
}
