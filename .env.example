# Copy to .env for local Docker testing. Never commit the populated file.
# Docker Compose reads .env; the API container receives only the explicit values
# in compose.yaml. Do not put secrets in tracked appsettings or Dockerfiles.
ASPNETCORE_ENVIRONMENT=Production
# For Visual Studio outside Docker only; Compose constructs its own SQL connection.
ConnectionStrings__WmsConnection=CHANGE_ME
JwtSettings__Secret=CHANGE_ME
JwtSettings__Issuer=WMS
JwtSettings__Audience=WMS
Frontend__AllowedOrigins__0=https://wms.local.test
AllowedHosts=wms.local.test
# Compose fixes Caddy's IP at 172.30.44.10 and passes that IP to the API.
# This key is for non-Compose hosting only.
ReverseProxy__TrustedProxies=CHANGE_ME
# Required only for Compose. Use distinct strong passwords. Avoid semicolons in
# WMS_DB_PASSWORD because Compose inserts it into a SQL connection string.
MSSQL_SA_PASSWORD=CHANGE_ME
WMS_DB_NAME=WMS
WMS_DB_PASSWORD=CHANGE_ME
Demo__Enabled=false
Demo__CleanupEnabled=true
