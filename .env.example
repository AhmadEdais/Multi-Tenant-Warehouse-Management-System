# API production environment. Replace every CHANGE_ME value before use.
# Keep the populated file outside the repository and Docker build context.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__WmsConnection=CHANGE_ME
JwtSettings__Secret=CHANGE_ME
JwtSettings__Issuer=CHANGE_ME
JwtSettings__Audience=CHANGE_ME
Frontend__AllowedOrigins__0=CHANGE_ME
AllowedHosts=CHANGE_ME
ReverseProxy__TrustedProxies=CHANGE_ME
Demo__Enabled=false
Demo__CleanupEnabled=true
